{
  "name": "Review",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string",
      "title": "Nome do autor"
    },
    "rating": {
      "type": "number",
      "title": "Nota",
      "default": 5
    },
    "text": {
      "type": "string",
      "title": "Avalia\u00e7\u00e3o",
      "format": "textarea"
    },
    "source": {
      "type": "string",
      "title": "Origem",
      "default": "Google"
    },
    "active": {
      "type": "boolean",
      "title": "Ativo",
      "default": true
    }
  },
  "required": [
    "author_name",
    "rating",
    "text"
  ]
}
