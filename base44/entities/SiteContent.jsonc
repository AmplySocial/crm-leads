{
  "name": "SiteContent",
  "type": "object",
  "properties": {
    "logo_url": {
      "type": "string",
      "title": "Logo"
    },
    "corretor_name": {
      "type": "string",
      "title": "Nome do corretor",
      "default": "Robson Corretor de Im\u00f3veis"
    },
    "corretor_photo": {
      "type": "string",
      "title": "Foto do corretor"
    },
    "creci": {
      "type": "string",
      "title": "CRECI",
      "default": "CRECI-MG 61483"
    },
    "hero_headline": {
      "type": "string",
      "title": "Headline do Hero",
      "default": "Encontre o im\u00f3vel certo para o pr\u00f3ximo cap\u00edtulo da sua vida."
    },
    "hero_subheadline": {
      "type": "string",
      "title": "Subheadline do Hero",
      "default": "Atendimento personalizado para quem busca comprar, vender ou investir em im\u00f3veis em Santa Luzia e regi\u00e3o."
    },
    "hero_image": {
      "type": "string",
      "title": "Imagem do Hero"
    },
    "about_title": {
      "type": "string",
      "title": "T\u00edtulo da se\u00e7\u00e3o Sobre",
      "default": "Mais do que encontrar im\u00f3veis. Encontrar oportunidades."
    },
    "about_text": {
      "type": "string",
      "title": "Texto da se\u00e7\u00e3o Sobre",
      "format": "textarea",
      "default": "Meu objetivo \u00e9 tornar a compra, venda ou investimento em um im\u00f3vel uma experi\u00eancia mais segura, transparente e personalizada."
    },
    "about_image": {
      "type": "string",
      "title": "Imagem da se\u00e7\u00e3o Sobre"
    },
    "sell_title": {
      "type": "string",
      "title": "T\u00edtulo se\u00e7\u00e3o Vender",
      "default": "Tem um im\u00f3vel para vender?"
    },
    "sell_text": {
      "type": "string",
      "title": "Texto se\u00e7\u00e3o Vender",
      "default": "Conte com um atendimento profissional para apresentar sua propriedade \u00e0s pessoas certas."
    },
    "investment_title": {
      "type": "string",
      "title": "T\u00edtulo se\u00e7\u00e3o Investimento",
      "default": "Propriedades tamb\u00e9m podem ser grandes oportunidades."
    },
    "investment_text": {
      "type": "string",
      "title": "Texto se\u00e7\u00e3o Investimento",
      "default": "Encontre terrenos, s\u00edtios, fazendas e im\u00f3veis com potencial para diferentes objetivos de investimento."
    },
    "cta_title": {
      "type": "string",
      "title": "T\u00edtulo CTA final",
      "default": "Seu pr\u00f3ximo im\u00f3vel pode estar mais perto do que voc\u00ea imagina."
    },
    "cta_text": {
      "type": "string",
      "title": "Texto CTA final",
      "default": "Fale com Robson e encontre uma propriedade que fa\u00e7a sentido para voc\u00ea."
    },
    "contact_phone": {
      "type": "string",
      "title": "Telefone",
      "default": "(31) 97595-3346"
    },
    "contact_whatsapp": {
      "type": "string",
      "title": "WhatsApp (n\u00famero, s\u00f3 d\u00edgitos)",
      "default": "5531975953346"
    },
    "contact_email": {
      "type": "string",
      "title": "E-mail",
      "default": "robsoncorretor46@gmail.com"
    },
    "contact_address": {
      "type": "string",
      "title": "Endere\u00e7o",
      "default": "R. Adolfo Loureiro, 317 - S\u00e3o Jo\u00e3o Batista, Santa Luzia - MG, 33010-100"
    },
    "contact_city": {
      "type": "string",
      "title": "Cidade",
      "default": "Santa Luzia - MG"
    },
    "social_instagram": {
      "type": "string",
      "title": "Instagram"
    },
    "social_facebook": {
      "type": "string",
      "title": "Facebook"
    },
    "seo_title": {
      "type": "string",
      "title": "SEO Title",
      "default": "Robson Corretor de Im\u00f3veis | Im\u00f3veis em Santa Luzia MG"
    },
    "seo_description": {
      "type": "string",
      "title": "SEO Description",
      "format": "textarea",
      "default": "Compra, venda e investimento em im\u00f3veis residenciais, casas, s\u00edtios, terrenos e fazendas em Santa Luzia e regi\u00e3o, Minas Gerais. CRECI-MG 61483."
    },
    "google_rating": {
      "type": "number",
      "title": "Nota Google",
      "default": 5.0
    },
    "google_reviews_count": {
      "type": "number",
      "title": "N\u00famero de avalia\u00e7\u00f5es Google",
      "default": 2
    }
  },
  "required": [
    "corretor_name"
  ]
}
